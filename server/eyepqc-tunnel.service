[Unit]
Description=EYEPQC restricted reverse TCP tunnel SSH daemon
After=network.target

[Service]
Type=simple
RuntimeDirectory=eyepqc-tunnel
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/sshd -t -f /etc/eyepqc-tunnel/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/eyepqc-tunnel/sshd_config
Restart=no
KillMode=control-group
TimeoutStopSec=15
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/eyepqc-tunnel

[Install]
WantedBy=multi-user.target
