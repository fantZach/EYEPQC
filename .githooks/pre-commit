#!/bin/sh
set -eu

git diff --cached --check

if [ -x .venv/Scripts/python.exe ]; then
    python=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
    python=.venv/bin/python
else
    echo 'pre-commit: create .venv and install requirements.txt first.' >&2
    exit 1
fi

"$python" sim/tb/test_m00.py
"$python" sim/tb/test_m10.py
"$python" sim/tb/test_m12.py
exec "$python" sim/tb/test_g5.py
