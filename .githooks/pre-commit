#!/bin/sh
set -eu

git diff --cached --check

if [ -x .venv/Scripts/python.exe ]; then
    python=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
    python=.venv/bin/python
else
    echo 'M00 pre-commit: create .venv and install requirements.txt first.' >&2
    exit 1
fi

"$python" sim/scripts/generate_vectors.py --check
"$python" sim/tb/test_m00.py
"$python" sim/tb/test_m01.py
"$python" sim/tb/test_aes_mvp.py
"$python" sim/tb/test_m02.py
"$python" sim/tb/test_m03.py
"$python" sim/tb/test_m04.py
exec "$python" sim/tb/test_m05.py
